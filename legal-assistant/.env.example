# OpenAI-совместимый API (на платформе — API организаторов). Реальные ключи сюда НЕ коммитить.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Эмбеддинги и реранкер (по умолчанию тот же адрес и ключ, что у LLM)
EMB_MODEL=baai/bge-m3
EMBEDDER_API_KEY=
RERANKER_MODEL=qwen/qwen3-reranker-8b
RERANKER_API_KEY=
USE_RERANKER=true

# Поведение
VERIFY=true
TEMPERATURE=0
MAX_TOKENS=1500
MAX_WORKERS=4
TOP_CHUNKS=10

# Веб-интерфейс
PORT=8000
